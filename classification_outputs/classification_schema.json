{
  "model_name": "Logistic Regression",
  "target_type": "Multiclass Classification (3 classes)",
  "classes": {
    "0": {
      "name": "Cần Hỗ Trợ (<60)",
      "range": "Exam_Score < 60",
      "meaning": "Cần Hỗ Trợ / At-Risk"
    },
    "1": {
      "name": "Đạt Chuẩn (60-80)",
      "range": "60 <= Exam_Score < 80",
      "meaning": "Đạt Chuẩn / On-Track"
    },
    "2": {
      "name": "Xuất Sắc (>=80)",
      "range": "Exam_Score >= 80",
      "meaning": "Xuất Sắc / High-Performing"
    }
  },
  "required_features": {
    "Gender": {
      "type": "categorical",
      "allowed_values": [
        "Female",
        "Male"
      ]
    },
    "HoursStudied/Week": {
      "type": "numerical",
      "min": 0.0,
      "max": 16.0,
      "unit": "hours"
    },
    "Tutoring": {
      "type": "categorical",
      "allowed_values": [
        "Yes",
        "No"
      ]
    },
    "Region": {
      "type": "categorical",
      "allowed_values": [
        "Urban",
        "Rural"
      ]
    },
    "Attendance(%)": {
      "type": "numerical",
      "min": 0.0,
      "max": 100.0,
      "unit": "%"
    },
    "Parent Education": {
      "type": "categorical",
      "allowed_values": [
        "None",
        "Primary",
        "Secondary",
        "Tertiary"
      ]
    }
  },
  "engineered_features": [
    "Effective_Study_Hours = HoursStudied/Week * (Attendance(%) / 100.0)",
    "Study_Intensity_Ratio = HoursStudied/Week / (Attendance(%) + 1.0)"
  ]
}